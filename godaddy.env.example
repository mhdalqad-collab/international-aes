# Add these values in GoDaddy Node.js Hosting > Settings > Secrets.
# Do not upload a real .env file containing passwords.

ARCHIVE_PASSWORD=replace-with-a-strong-password
ARCHIVE_SESSION_SECRET=replace-with-at-least-32-random-characters
FILE_ENCRYPTION_SECRET=replace-with-a-different-32-character-random-secret
ADMIN_PASSWORD=replace-with-a-different-password-of-at-least-12-characters
ADMIN_SESSION_SECRET=replace-with-another-32-character-random-secret

# Use DATABASE_URL when GoDaddy provides a complete MySQL connection URL:
DATABASE_URL=mysql://username:password@hostname:3306/database_name

# Or remove DATABASE_URL and enter the individual settings instead:
# DB_HOST=hostname
# DB_PORT=3306
# DB_USER=username
# DB_PASSWORD=password
# DB_NAME=database_name
# DB_SSL=false
